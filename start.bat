@echo off
chcp 65001 >nul
title Система сдачи работ
cd /d "%~dp0"

echo ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
echo           Система сдачи работ
echo ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
echo.

:: -------------------------------------------------------------------
:: 1. ПРОВЕРКА И УСТАНОВКА PYTHON 3.14.5
:: -------------------------------------------------------------------
echo [1/4] Проверка наличия Python...

python --version >nul 2>&1
if errorlevel 1 (
    echo Python не найден. Начинаю автоматическую установку Python 3.14.5...
    
    :: Скачиваем установщик Python 3.14.5
    echo Скачивание Python 3.14.5 с официального сайта...
    curl -o python_installer.exe https://www.python.org/ftp/python/3.14.5/python-3.14.5-amd64.exe
    
    :: Устанавливаем Python тихо (без окон) с добавлением в PATH и для всех пользователей
    echo Установка Python 3.14.5. Пожалуйста, подождите...
    start /wait python_installer.exe InstallAllUsers=1 PrependPath=1 Include_test=0 SimpleInstall=1
    
    :: Удаляем установщик
    del python_installer.exe
    echo Python 3.14.5 успешно установлен!
) else (
    echo Python уже установлен.
)

:: -------------------------------------------------------------------
:: 2. ПОДГОТОВКА ВИРТУАЛЬНОГО ОКРУЖЕНИЯ
:: -------------------------------------------------------------------
echo.
echo [2/4] Подготовка виртуального окружения...

:: Создаём папку для виртуального окружения, если её нет
if not exist "venv" (
    echo Создание виртуального окружения...
    python -m venv venv
) else (
    echo Виртуальное окружение уже существует.
)

:: Активируем виртуальное окружение
call venv\Scripts\activate.bat

:: -------------------------------------------------------------------
:: 3. УСТАНОВКА ЗАВИСИМОСТЕЙ (БИБЛИОТЕК)
:: -------------------------------------------------------------------
echo.
echo [3/4] Проверка и установка зависимостей...

:: Создаём файл requirements.txt, если его нет
if not exist "requirements.txt" (
    echo Создание requirements.txt...
    echo flask > requirements.txt
    echo markupsafe >> requirements.txt
)

:: Обновляем pip и устанавливаем все библиотеки из файла
python -m pip install --upgrade pip
pip install -r requirements.txt

:: -------------------------------------------------------------------
:: 4. ЗАПУСК СЕРВЕРА
:: -------------------------------------------------------------------
echo.
echo [4/4] Запуск сервера...
echo.

:: Запускаем сервер в фоновом режиме
start /b python app.py

:: Ждём, пока сервер поднимется
timeout /t 3 /nobreak >nul

:: Открываем браузер
start http://localhost:5000

echo.
echo ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
echo             СЕРВЕР ЗАПУЩЕН!
echo ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
echo.
echo Чтобы остановить сервер, закрой это окно.
echo.
pause